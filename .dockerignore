# Every hidden entry at the context root (local tool state, editor and agent
# directories), except the Git refs the build reads for its revision.
.*
!.git
.git/*
!.git/HEAD
!.git/refs
!.git/packed-refs
target
dist
**/__pycache__
local.env
local.env.*
# The leak guard's machine-specific deny-list (tests/leak_guard.py).
leak-denylist.local
**/leak-denylist.local
.env
.env.*
**/local.env
**/local.env.*
**/.env
**/.env.*
.venv
venv
**/.venv
**/venv
logs
**/logs
*.log
**/*.log
*.prof
*.sqlite
.pytest_cache
**/.pytest_cache
.aws
.ssh
.netrc
**/.aws
**/.ssh
**/.netrc
**/credentials
**/*.pem
**/*.key
.docker
**/.docker
.cargo/credentials
.cargo/credentials.toml
**/.cargo/credentials
**/.cargo/credentials.toml
.pypirc
**/.pypirc
.npmrc
**/.npmrc
