# timeout 880
# gpus 2
# Freeze helpers and cubins before the queue copies this file.
set -euo pipefail
l2_snapshot='@SNAPSHOT@'
l2_root='@ROOT@'
l2_mode=${1:-run}
case "$l2_mode" in run|--dry-run) ;; *) exit 2;; esac
l2_visible=${CUDA_VISIBLE_DEVICES:-}
source "${XDG_CONFIG_HOME:-$HOME/.config}/chopinfer/local.env"
export CUDA_VISIBLE_DEVICES="$l2_visible"
unset CHOPINFER_KERNEL_GPU CHOPINFER_KERNEL_GPUS CHOPINFER_KERNEL_REQUIRE CHOPINFER_KERNEL_SHARED_DEVICE KERNELS_LOCK_UPDATE
export CHOPINFER_KERNEL_EVICTION=read PYTHONDONTWRITEBYTECODE=1
export CHOPINFER_DEEPSEEK41_FOLD_CUBINS="$l2_snapshot/cubins"
l2_start=$(date +%s)
l2_out="$l2_root/direct-run-$l2_start-$$"
mkdir -p "$l2_out"
exec > >(tee "$l2_out/job.log") 2>&1
printf '%s  %s\n' '@MANIFEST_SHA@' "$l2_snapshot/SHA256SUMS" | sha256sum --check --status
(cd "$l2_snapshot" && sha256sum --check --quiet SHA256SUMS)
python3 -B "$l2_snapshot/fold_bandwidth_job.py" dry "$l2_snapshot" "$l2_out"
if [ "$l2_mode" = --dry-run ]; then
  printf '{"exit_code":0,"gpu_launched":false}\n' > "$l2_out/verdict.json"
  echo "CPU dry run passed: $l2_out"
  exit 0
fi
: "${CUDA_VISIBLE_DEVICES:?the runner must allocate two idle GPUs}"
export CHOPINFER_KERNEL_REQUIRE=1 CHOPINFER_KERNEL_TIMEOUT_SECS=790
l2_pid=
power() {
  nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-gpu=index,power.limit --format=csv,noheader,nounits > "$l2_out/power-$1.csv"
  python3 - "$l2_out/power-$1.csv" <<'POWER'
import csv,sys
with open(sys.argv[1]) as stream: rows=list(csv.reader(stream))
assert len(rows)==2 and all(float(r[1])==250 for r in rows),rows
POWER
}
finish() {
  l2_rc=$?
  trap - EXIT INT TERM
  set +e
  if [ -n "$l2_pid" ]; then
    kill -TERM -- "-$l2_pid" 2>/dev/null
    wait "$l2_pid" 2>/dev/null
  fi
  power after || l2_rc=1
  journalctl -k --since "@$l2_start" --no-pager > "$l2_out/kernel.log" 2> "$l2_out/journal.err"
  l2_journal=$?
  rg -i 'NVRM:.*Xid' "$l2_out/kernel.log" > "$l2_out/xids.txt"
  if [ "$l2_journal" -ne 0 ] || [ -s "$l2_out/xids.txt" ]; then l2_rc=1; fi
  printf '{"exit_code":%d,"journal_exit":%d,"gpu_exit_code":%s,"gpu_launched":true}\n' "$l2_rc" "$l2_journal" "${l2_test_rc:-null}" > "$l2_out/verdict.json"
  echo "exit $l2_rc: $l2_out"
  exit "$l2_rc"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
power before
nvidia-smi -i "$CUDA_VISIBLE_DEVICES" --query-compute-apps=pid --format=csv,noheader,nounits > "$l2_out/processes-before.txt"
if [ -s "$l2_out/processes-before.txt" ]; then echo 'Allocated GPUs are not idle' >&2; exit 1; fi
setsid timeout --signal=TERM --kill-after=10s 830s python3 -B "$l2_snapshot/fold_bandwidth_job.py" pair "$l2_snapshot" "$l2_out" &
l2_pid=$!
l2_test_rc=0
wait "$l2_pid" || l2_test_rc=$?
l2_pid=
if [ "$l2_test_rc" -ne 0 ]; then exit "$l2_test_rc"; fi
echo 'Bitwise and exclusive matrices complete; only both-device wins qualify; serving remains disabled.'
