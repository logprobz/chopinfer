# Rust dev and test profile for ci/cpu.sh, ci/quick.sh and the clean
# qualification gate, which pass it to every nested Cargo build. Opt-level 1
# ran the fake-host and geometry checks two to five times faster for about a
# fifth more compile time; line-tables-only debug information halves the
# target directory and keeps file and line numbers in backtraces (see
# docs/contributing.md#checks). Debug assertions and overflow checks stay on. A variable
# already set in the environment takes precedence.
CARGO_PROFILE_DEV_OPT_LEVEL=1
CARGO_PROFILE_TEST_OPT_LEVEL=1
CARGO_PROFILE_DEV_DEBUG=line-tables-only
CARGO_PROFILE_TEST_DEBUG=line-tables-only
CARGO_PROFILE_DEV_DEBUG_ASSERTIONS=true
CARGO_PROFILE_TEST_DEBUG_ASSERTIONS=true
CARGO_PROFILE_DEV_OVERFLOW_CHECKS=true
CARGO_PROFILE_TEST_OVERFLOW_CHECKS=true
