# Template instance example. MiMo at TP2 is experimental: not GPU qualified.
CHOPINFER_EXPECTED_BUNDLE_ID=mimo.v26.flash.v2
CUDA_VISIBLE_DEVICES=0,1
CHOPINFER_MODEL=/var/lib/chopinfer/models/mimo-v2.6-flash
CHOPINFER_MODEL_CACHE=/var/lib/chopinfer/model-cache
CHOPINFER_TENSOR_PARALLEL_SIZE=2
CHOPINFER_LISTEN=127.0.0.1:8311
CHOPINFER_SERVE_ARGS=
