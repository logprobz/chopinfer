# Machine-specific settings for Chopinfer tools. Copy to local.env in the
# checkout root (gitignored) or to ~/.config/chopinfer/local.env, then edit.
# ci/cpu.sh, ci/quick.sh, tools/ and the qualification scripts source it, after
# your shell's exports. A plain `export NAME=value` here replaces the shell's
# value for the scripts that source this file; the `: "${NAME:=value}"` lines
# below only fill in variables that are unset or empty. The qualification
# loader (tools/qual/common.py) reads only `export CHOPINFER_*=value` lines and
# keeps values already set in the shell. See docs/toolchain.md.

# CUDA 13.2 toolkit root for nvcc and headers (default /usr/local/cuda).
# export CHOPINFER_CUDA_HOME=/usr/local/cuda

# Rust toolchain and Cargo state.
export CARGO_HOME="$HOME/.cargo"
export CARGO_NET_OFFLINE=true
export PATH="$HOME/.rustup/toolchains/1.89.0-x86_64-unknown-linux-gnu/bin:$PATH"
# Keep TMPDIR short: tests bind Unix sockets under it, and a socket path must
# stay under 108 bytes. ci/cpu.sh and ci/quick.sh refuse one that is missing,
# not writable or longer than 64 bytes.
: "${TMPDIR:=/tmp}"
export TMPDIR

# Model caches, qualification runs and logs.
# Change this to a large data filesystem before downloading checkpoints or running evaluations.
export CHOPINFER_DATA="$HOME/chopinfer-data"
# GPU reference runner Python, built with tools/refrun/requirements-cu130.txt.
# export CHOPINFER_REFRUN_PYTHON="$CHOPINFER_DATA/refrun/venv-cu130/bin/python"

# Temporary space for local tools.
: "${CHOPINFER_SCRATCH:=/tmp}"
export CHOPINFER_SCRATCH

# Maintainer tooling only; contributors leave these unset.
# Key directory (0700, key file 0600) of the journal capture seal; see
# tools/journal_proof/README.md. Defaults to $CHOPINFER_DATA/journal-proof/authority.
# export CHOPINFER_JOURNAL_AUTHORITY="$CHOPINFER_DATA/journal-proof/authority"
# Shared build host queue, tools/dev/heavy.sh (docs/development-loop.md
# "Shared build hosts"). Its state directory, shared by every user of the
# host; slots and CPUs per slot (defaults 4, 2 while a gate runs, and 8);
# and an optional root for one Cargo target per worktree, with the size
# above which --status warns.
# export CHOPINFER_HEAVY_DIR="$CHOPINFER_DATA/heavy"
# export CHOPINFER_HEAVY_SLOTS=4 CHOPINFER_HEAVY_SLOTS_DURING_GATE=2 CHOPINFER_HEAVY_THREADS=8
# export CHOPINFER_TARGET_ROOT="$CHOPINFER_DATA/targets" CHOPINFER_TARGET_WARN_GB=250
# Wrapper that admits heavy CPU commands, used by tools/journal_proof/capture.py
# for its build and test run; unset runs them directly. Give the absolute path
# of a checkout's tools/dev/heavy.sh.
# export CHOPINFER_HEAVY_WRAPPER="/path/to/checkout/tools/dev/heavy.sh"

# Untracked deny-list of machine-specific leak guard patterns (hostname,
# local tool directories), one regular expression per line; see
# tests/leak_guard.py. Defaults to ~/.config/chopinfer/leak-denylist.
# export CHOPINFER_LEAK_DENYLIST="$HOME/.config/chopinfer/leak-denylist"

# Model inputs. ci/cpu.sh always runs the geometry and export
# recipes, which fail without the Qwen3.8 and MiMo tokenizer files (from the
# *_TOKENIZER_DIR or *_CHECKPOINT variables) and MiMo's DFlash
# mask_embedding.pt; see docs/contributing.md, "Full CPU check prerequisites".
# Other tests that need these inputs skip while they are unset.
# MiMo-V2.6-Flash-MOPD checkpoint directory and functional/GSM8K input fixtures.
# export CHOPINFER_MIMO_CHECKPOINT="$HOME/models/mimo-v2.6-flash-mopd"
# export CHOPINFER_MIMO_FIXTURES="$HOME/mimo26/fixtures"
# MiMo tokenizer files alone (defaults to the checkpoint directory), and the
# directory holding the DFlash drafter's mask_embedding.pt (defaults to the
# tokenizer or checkpoint directory's dflash/ subdirectory).
# export CHOPINFER_MIMO_TOKENIZER_DIR="$CHOPINFER_MIMO_CHECKPOINT"
# export CHOPINFER_MIMO_DFLASH_DIR="$CHOPINFER_MIMO_CHECKPOINT/dflash"

# Qwen3.8-Flash-Next-FP8 snapshot directory, revision
# 236dfdf285828023ca3bcd3f37366c58a3469b13.
# export CHOPINFER_QWEN38_CHECKPOINT="$HOME/.cache/huggingface/hub/models--Qwen--Qwen3.8-Flash-Next-FP8/snapshots/236dfdf285828023ca3bcd3f37366c58a3469b13"
# Qwen tokenizer files alone (defaults to the checkpoint directory).
# export CHOPINFER_QWEN38_TOKENIZER_DIR="$CHOPINFER_QWEN38_CHECKPOINT"

# Pinned references (models/*/qual-references.lock.json). ci/cpu.sh's
# reference checks read them, so ci/cpu.sh refuses to start while one is unset
# or not a directory, and ci/quick.sh does when it runs those checks.
# Directory holding the pinned 128K F32 reference.json and
# reference.workload.json of Qwen's long_context_128k check.
# export CHOPINFER_QWEN38_LONG_REFERENCE="$CHOPINFER_DATA/qwen38-refs/long-context-128k"
# Directory of the reference runner's Qwen layer taps for the layers check:
# run.json, f32.json and bf16.json beside the taps/ they describe.
# export CHOPINFER_QWEN38_LAYER_REFERENCE="$CHOPINFER_DATA/qwen38-refs/layers"
# The same for GLM: two runner runs of one workload, F32 and BF16 with the FP8
# latent (models/glm5next/README.md).
# export CHOPINFER_GLM5NEXT_LAYER_REFERENCE="$CHOPINFER_DATA/glm5next/layers"

# GLM 5.3 Flash checkpoint directories: zai-org/GLM-5.3-Flash
# at revision eb9eb208eb0d988989d07a6a12d0fdeb5f52574a, and the NVFP4 exports
# local-inference-lab/GLM-5.3-Flash-NVFP4 at 175ae8ce3b5af842b0d0140dbeb43e9cfc557c49
# and nvidia/GLM-5.3-Flash-NVFP4 at da920bb0b9f4a06727223a349e55468e38352348.
# export CHOPINFER_GLM5NEXT_CHECKPOINT="$HOME/models/glm-5.3-flash"
# export CHOPINFER_GLM5NEXT_NVFP4_CHECKPOINT="$HOME/models/glm-5.3-flash-nvfp4"
# export CHOPINFER_GLM5NEXT_NVIDIA_NVFP4_CHECKPOINT="$HOME/models/glm-5.3-flash-nvfp4-nvidia"

# Dumped activations for the BF16 accumulation studies in kernel-lab
# (tests/mma_accumulation.rs, the gemm::accumulation ops tests and
# qwen38_gemm_accumulation): the MiMo numerics audit, the GPU reference
# runner's Qwen BF16 taps (one directory of step taps per prompt; see
# crates/kernel-lab/README.md) and a Qwen bundle dump's step directories.
# export CHOPINFER_MIMO_AUDIT_DIR="$CHOPINFER_DATA/numerics-audit/full"
# export CHOPINFER_QWEN38_LAYER_DUMPS="$CHOPINFER_DATA/qwen38-refs/runner-layers"
# export CHOPINFER_QWEN38_STEP_DUMPS="$CHOPINFER_DATA/qwen38-dumps/run1"
