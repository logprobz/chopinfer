# The service pins CHOPINFER_EXPECTED_BUNDLE_ID=mimo.v26.flash.v2.
# The Hugging Face checkpoint loads directly; the model cache must be writable.
CHOPINFER_MODEL=/var/lib/chopinfer/models/mimo-v2.6-flash
CHOPINFER_MODEL_CACHE=/var/lib/chopinfer/model-cache
CHOPINFER_LISTEN=127.0.0.1:8000
CHOPINFER_MAX_SEQUENCES=32
CHOPINFER_MAX_BATCH_TOKENS=8192
CHOPINFER_PREFILL_CHUNK_TOKENS=2048
# Set CHOPINFER_QUEUE_DEPTH only to opt into a waiting queue bound.
# CHOPINFER_GPU_MEMORY_UTILIZATION defaults to 1.0: the server takes each GPU's
# memory but a 1 GiB reserve. Lower it to leave memory for other programs.
# auto serves the package's preferred KV layout, BF16; fp8 about doubles the KV
# tokens. The host logs the choice at startup.
CHOPINFER_KV_CACHE_DTYPE=auto
CHOPINFER_DRAIN_TIMEOUT_MS=30000
# The default package serves text and images. CHOPINFER_MODALITIES=all also
# serves video and audio, at the cost of KV capacity.
# The prepared package carries the drafter the checkpoint supports and
# speculates by default (DFlash: adaptive K7, per-block cost; MTP: adaptive
# K3). CHOPINFER_SPECULATIVE_TOKENS=0 serves AR; CHOPINFER_SPECULATION and
# CHOPINFER_DRAFT_COST override the policy and cost.
# CHOPINFER_MIMO_F32_LOGITS=0 selects the BF16 decode head.
# CHOPINFER_VERIFY_MODEL=1 checks every checkpoint file's SHA-256 before
# serving; CHOPINFER_VERIFY_MANIFEST names the recorded checksums.
CHOPINFER_SERVE_ARGS=
