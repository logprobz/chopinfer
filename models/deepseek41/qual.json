    },
    "soak": {
      "module": "soak",
      "args": [
        "--url",
        "{url}",
        "--model",
        "{model}",
        "--structured-mix"
      ],
      "timeout_seconds": 7200,
      "receipt": "*-soak.json",
      "cohort_args": {
        "quick": [
          "--duration",
          "60",
          "--concurrency",
          "4"
        ],
        "full": [
          "--duration",
          "1200",
          "--concurrency",
          "32",
          "--prefix-mix"
        ]
      },
      "rules": [
        {
          "path": [
            "passed"
          ],
          "op": "eq",
          "value": true,
          "source": "tools/qual/README.md#release-gates"
        }
      ]
    },
    "prefix_exact": {
      "module": "prefix_exact",
      "args": [
        "report",
        "--record",
        "{prefix_record_1}",
        "--record",
        "{prefix_record_2}"
      ],
      "timeout_seconds": 1740,
      "stdout_json": true,
      "files": [
        "prefix_record_1",
        "prefix_record_2"
      ],
      "rules": [
        {
          "path": [
            "passed"
          ],
          "op": "eq",
          "value": true,
          "source": "tools/qual/README.md#capabilities-and-required-evidence"
        }
      ]
    },
    "preemption_exact": {
      "module": "preempt_compare",
      "args": [
        "compare",
        "--reserved",
        "{preemption_reserved}",
        "--preempted",
        "{preemption_candidate}",
        "--every",
        "32",
        "--exact"
      ],
      "timeout_seconds": 1740,
      "stdout_json": true,
      "files": [
        "preemption_reserved",
        "preemption_candidate"
      ],
      "rules": [
        {
          "path": [
            "passed"
          ],
          "op": "eq",
          "value": true,
          "source": "tools/qual/README.md#capabilities-and-required-evidence"
        },
        {
          "path": [
            "exact"
          ],
          "op": "eq",
          "value": true,
          "source": "tools/qual/README.md#capabilities-and-required-evidence"
        },
        {
          "path": [
            "requests"
          ],
          "op": "ge",
          "value": 1,
          "source": "tools/qual/README.md#capabilities-and-required-evidence"
        },
        {
          "path": [
            "positions_after_first_preemption"
          ],
          "op": "ge",
          "value": 1,
          "source": "tools/qual/README.md#capabilities-and-required-evidence"
        }
      ]
    }
  },
