# The service pins CHOPINFER_EXPECTED_BUNDLE_ID=glm5next.v1.
# The Hugging Face checkpoint loads directly; the model cache must be writable.
# The FP8 checkpoint and both NVFP4 exports serve the same bundle at TP4 on
# four GPUs; the checkpoint's layout selects the profile.
CHOPINFER_MODEL=/var/lib/chopinfer/models/glm-5.3-flash
CHOPINFER_MODEL_CACHE=/var/lib/chopinfer/model-cache
CHOPINFER_LISTEN=127.0.0.1:8000
CHOPINFER_TENSOR_PARALLEL_SIZE=4
# The package maximum, and the qualified limit of every GLM profile.
CHOPINFER_MAX_SEQUENCES=32
CHOPINFER_MAX_BATCH_TOKENS=8192
CHOPINFER_PREFILL_CHUNK_TOKENS=2048
# Set CHOPINFER_QUEUE_DEPTH only to opt into a waiting queue bound.
CHOPINFER_KV_MEMORY_FRACTION=0.9
# auto serves the package's preferred KV layout, FP8 latent KV; bf16 doubles
# its size. The host logs the choice at startup.
CHOPINFER_KV_CACHE_DTYPE=auto
CHOPINFER_DRAIN_TIMEOUT_MS=30000
# The package serves text and images by default. The MTP drafter speculates
# by default (adaptive K3); CHOPINFER_SPECULATIVE_TOKENS=0 serves AR.
# Pass --context-parallel-size 2 or 4 in CHOPINFER_SERVE_ARGS for decode
# context parallelism (the tp4-mtp-dcp2 and tp4-mtp-dcp4 profiles).
# CHOPINFER_VERIFY_MODEL=1 checks every checkpoint file's SHA-256 before
# serving; the FP8 checkpoint is 328 GB, so this reads it from disk.
CHOPINFER_SERVE_ARGS=
