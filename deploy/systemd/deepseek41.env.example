# The service pins CHOPINFER_EXPECTED_BUNDLE_ID=deepseek41.v1.
# The Hugging Face checkpoint loads directly; the model cache must be writable.
# The bundle serves it at TP4 on four GPUs under the tp4-dspark profile.
CHOPINFER_MODEL=/var/lib/chopinfer/models/deepseek-v4.1-flash
CHOPINFER_MODEL_CACHE=/var/lib/chopinfer/model-cache
CHOPINFER_LISTEN=127.0.0.1:8000
CHOPINFER_TENSOR_PARALLEL_SIZE=4
# The package maximum, and the qualified limit of tp4-dspark.
CHOPINFER_MAX_SEQUENCES=32
# The profile owns its 8192-token batch and prefill chunk and its adaptive
# prefill policy (a 750 ms decode cadence target); leave them unset.
# Set CHOPINFER_QUEUE_DEPTH only to opt into a waiting queue bound.
# CHOPINFER_GPU_MEMORY_UTILIZATION defaults to 1.0: the server takes each GPU's
# memory but the profile's graph memory reserve (640 MiB for tp4-dspark).
# auto serves the package's native KV layout.
CHOPINFER_KV_CACHE_DTYPE=auto
CHOPINFER_DRAIN_TIMEOUT_MS=30000
# The DSpark drafter speculates by default; CHOPINFER_SPECULATIVE_TOKENS=0
# serves AR, the baseline and correctness control.
# The Engram tables (about 203 GB of the checkpoint) are read through the host
# page cache; the host needs RAM for them beside the server. Pass
# --prewarm-mapped-views auto in CHOPINFER_SERVE_ARGS to warm them in the
# background after readiness when MemAvailable holds them plus 16 GiB.
# CHOPINFER_VERIFY_MODEL=1 checks every checkpoint file's SHA-256 before
# serving; the checkpoint is about 510 GB, so this reads it from disk.
CHOPINFER_SERVE_ARGS=
