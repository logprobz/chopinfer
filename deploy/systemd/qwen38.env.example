# The service pins CHOPINFER_EXPECTED_BUNDLE_ID=qwen38.flash.v2.
# The Hugging Face checkpoint loads directly; the model cache must be writable.
CHOPINFER_MODEL=/var/lib/chopinfer/models/qwen3.8-flash
CHOPINFER_MODEL_CACHE=/var/lib/chopinfer/model-cache
CHOPINFER_LISTEN=127.0.0.1:8000
CHOPINFER_MAX_SEQUENCES=32
CHOPINFER_MAX_BATCH_TOKENS=8192
CHOPINFER_PREFILL_CHUNK_TOKENS=2048
# Set CHOPINFER_QUEUE_DEPTH only to opt into a waiting queue bound.
# CHOPINFER_GPU_MEMORY_UTILIZATION defaults to 1.0: the server takes each GPU's
# memory but a 1 GiB reserve. Lower it to leave memory for other programs.
# auto serves the package's preferred KV layout, BF16; fp8 about doubles the KV
# tokens. The host logs the choice at startup.
CHOPINFER_KV_CACHE_DTYPE=auto
CHOPINFER_DRAIN_TIMEOUT_MS=30000
# The image defaults enable the prefix cache; pass --prefix-cache off in
# CHOPINFER_SERVE_ARGS to diagnose cold prefill.
# MTP packages default to adaptive K3; CHOPINFER_SPECULATIVE_TOKENS=0 selects AR.
# The package plans the checkpoint's vision tower when present; media input
# awaits Q-11 qualification.
# CHOPINFER_VERIFY_MODEL=1 checks every checkpoint file's SHA-256 before serving.
CHOPINFER_SERVE_ARGS=
