    "evals_gsm8k": {
      "module": "evals",
      "args": [
        "run",
        "--url",
        "{url}",
        "--model",
        "{model}",
        "--arm",
        "native",
        "--run-id",
        "{run_id}",
        "--suites",
        "gsm8k",
        "--server-log",
        "{server_log}"
      ],
      "timeout_seconds": 7200,
      "receipt": "*-evals-native.json",
      "files": [
        "server_log"
      ],
      "constants": {
        "evals": {
          "SAMPLING": {
            "value": {
              "temperature": 1.0,
              "top_p": 1.0,
              "max_tokens": 262144
            },
            "source": "models/deepseek41/README.md#qualification"
          }
        }
      },
      "rules": [
        {
          "path": [
            "passed"
          ],
          "op": "eq",
          "value": true,
          "source": "tools/qual/README.md#release-gates"
        },
        {
          "path": [
            "items"
          ],
          "op": "ge",
          "value": 1319,
          "source": "tools/qual/README.md#release-gates"
        },
        {
          "path": [
            "suites",
            "gsm8k",
            "count"
